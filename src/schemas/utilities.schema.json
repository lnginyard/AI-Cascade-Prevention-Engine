{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UtilitiesTelemetry",
  "type": "object",
  "properties": {
    "source": { "const": "utilities" },
    "timestamp": { "type": "string", "format": "date-time" },
    "utilityId": { "type": "string" },
    "metrics": {
      "type": "object",
      "properties": {
        "capacityPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "workforceAbsencePct": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "required": ["capacityPct"]
    }
  },
  "required": ["source", "timestamp", "utilityId", "metrics"]
}
