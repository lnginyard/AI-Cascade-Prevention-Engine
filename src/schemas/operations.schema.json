{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OperationsTelemetry",
  "description": "Operational efficiency and process health metrics",
  "type": "object",
  "properties": {
    "source": { "const": "operations" },
    "timestamp": { "type": "string", "format": "date-time" },
    "processId": { "type": "string" },
    "metrics": {
      "type": "object",
      "properties": {
        "throughputPctOfTarget": { "type": "number", "minimum": 0, "maximum": 200 },
        "cycleTimePctOfNorm": { "type": "number", "minimum": 0, "maximum": 200 },
        "defectRatePct": { "type": "number", "minimum": 0, "maximum": 100 },
        "costPerUnitPctOfTarget": { "type": "number", "minimum": 0, "maximum": 200 },
        "bottleneckSeverity": { "type": "string", "enum": ["none", "low", "medium", "high", "critical"] },
        "reworkRatePct": { "type": "number", "minimum": 0, "maximum": 100 },
        "workerSafetyIncidents": { "type": "integer", "minimum": 0 }
      },
      "required": ["throughputPctOfTarget"]
    }
  },
  "required": ["source", "timestamp", "processId", "metrics"]
}
