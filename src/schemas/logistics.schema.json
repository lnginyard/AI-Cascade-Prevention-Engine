{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LogisticsTelemetry",
  "type": "object",
  "properties": {
    "source": { "const": "logistics" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nodeId": { "type": "string" },
    "metrics": {
      "type": "object",
      "properties": {
        "throughputPctOfNorm": { "type": "number", "minimum": 0, "maximum": 200 },
        "avgLeadDays": { "type": "number", "minimum": 0 },
        "backlogContainers": { "type": "integer", "minimum": 0 }
      },
      "required": ["throughputPctOfNorm"]
    }
  },
  "required": ["source", "timestamp", "nodeId", "metrics"]
}
